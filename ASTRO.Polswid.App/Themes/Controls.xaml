<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:ASTRO.Polswid.App.Controls"
                    xmlns:l="clr-namespace:ASTRO.Polswid.App.Localization">

    <c:PadButtonNameConverter x:Key="PadName"/>
    <c:LocEnumConverter x:Key="LocEnum"/>
    <c:InverseBoolConverter x:Key="InvBool"/>
    <c:BrushKeyConverter x:Key="BrushKey"/>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <c:InverseBoolToVisibilityConverter x:Key="InvVis"/>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <DataTemplate x:Key="PadButtonItem">
        <TextBlock Text="{Binding Converter={StaticResource PadName}}"/>
    </DataTemplate>
    <DataTemplate x:Key="EnumItem">
        <TextBlock Text="{Binding Converter={StaticResource LocEnum}}"/>
    </DataTemplate>
    <DataTemplate x:Key="DeviceItem"><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/></DataTemplate>
    <DataTemplate x:Key="ProfileItem"><TextBlock Text="{Binding Name}"/></DataTemplate>
    <DataTemplate x:Key="PresetItem">
        <TextBlock Text="{Binding Converter={StaticResource LocEnum}, ConverterParameter=preset}"/>
    </DataTemplate>

    <!-- round "?" help button with popup -->
    <Style TargetType="c:HelpButton">
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTip" Value="{l:Tr tip_help}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:HelpButton">
                    <Grid>
                        <ToggleButton x:Name="tb" Width="22" Height="22" Cursor="Hand" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" CornerRadius="11" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="؟" FontWeight="Bold" FontSize="12" Foreground="{StaticResource NeonBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="pop" IsOpen="{Binding IsChecked, ElementName=tb, Mode=TwoWay}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=tb}">
                            <Border Margin="6" Padding="16" Width="400" CornerRadius="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                    FlowDirection="{Binding Flow, Source={x:Static l:Loc.Instance}}" Effect="{StaticResource NeonGlow}">
                                <ScrollViewer MaxHeight="440">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Entry.Title, RelativeSource={RelativeSource TemplatedParent}}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                        <TextBlock Text="{l:Tr hp_what}" Style="{StaticResource H2}" Margin="0,4,0,2"/>
                                        <TextBlock Text="{Binding Entry.What, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <TextBlock Text="{l:Tr hp_effect}" Style="{StaticResource H2}" Margin="0,10,0,2"/>
                                        <TextBlock Text="{Binding Entry.Effect, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <TextBlock Text="{l:Tr hp_need}" Style="{StaticResource H2}" Margin="0,10,0,2"/>
                                        <TextBlock Text="{Binding Entry.Need, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <TextBlock Text="{l:Tr hp_example}" Style="{StaticResource H2}" Margin="0,10,0,2"/>
                                        <TextBlock Text="{Binding Entry.Example, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <TextBlock Text="{l:Tr hp_risk}" Style="{StaticResource H2}" Margin="0,10,0,2"/>
                                        <TextBlock Text="{Binding Entry.Risk, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:Badge">
        <Setter Property="Margin" Value="6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Badge">
                    <Border CornerRadius="9" Padding="8,1" BorderThickness="1" BorderBrush="{TemplateBinding Tint}">
                        <TextBlock Text="{TemplateBinding Text}" FontSize="10" Foreground="{TemplateBinding Tint}" TextWrapping="NoWrap"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:SliderRow">
        <Setter Property="Margin" Value="0,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SliderRow">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Label}" VerticalAlignment="Center"/>
                                <c:HelpButton Topic="{Binding Help, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </StackPanel>
                            <TextBlock Text="{TemplateBinding Hint}" Style="{StaticResource Muted}" FontSize="11"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding RecommendedText}" Foreground="{StaticResource GoodBrush}" FontSize="11"/>
                                <Button x:Name="PART_Reset" Content="↺" Padding="6,0" Margin="6,0,0,0" FontSize="11" ToolTip="{l:Tr tip_use_rec}"
                                        Visibility="{Binding CanReset, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </StackPanel>
                        <Slider x:Name="PART_Slider" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FlowDirection="LeftToRight"
                                Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                SmallChange="{TemplateBinding Step}" LargeChange="{TemplateBinding Step}"
                                TickFrequency="{TemplateBinding Step}" IsSnapToTickEnabled="True"
                                Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource NeonBrush}"
                                   FlowDirection="LeftToRight" Text="{TemplateBinding DisplayText}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- big primary action button -->
    <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="22,12"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <!-- section tab (pill) -->
    <Style x:Key="Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" CornerRadius="16" Padding="16,7" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
