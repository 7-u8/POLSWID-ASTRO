<UserControl x:Class="ASTRO.Polswid.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ASTRO.Polswid.App.Views"
             xmlns:l="clr-namespace:ASTRO.Polswid.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- sidebar -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,18">
                    <StackPanel DockPanel.Dock="Top" Margin="10,0,10,24" FlowDirection="LeftToRight">
                        <TextBlock Text="ASTRO" FontSize="26" FontWeight="Black" Foreground="White" Effect="{StaticResource NeonGlow}"/>
                        <TextBlock Text="POLSWID" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource NeonBrush}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Profile.Name}" Style="{StaticResource Muted}" Margin="10,0"/>
                    <StackPanel>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" IsChecked="{Binding IsHome, Mode=OneWay}" Command="{Binding GoCommand}" CommandParameter="Home">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE80F;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0"/><TextBlock Text="{l:Tr nav_home}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" IsChecked="{Binding IsAdvanced, Mode=OneWay}" Command="{Binding GoCommand}" CommandParameter="Advanced">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0"/><TextBlock Text="{l:Tr nav_advanced}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" IsChecked="{Binding IsSettings, Mode=OneWay}" Command="{Binding GoCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE115;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0"/><TextBlock Text="{l:Tr nav_settings}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" IsChecked="{Binding IsHelp, Mode=OneWay}" Command="{Binding GoCommand}" CommandParameter="Help">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE897;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0"/><TextBlock Text="{l:Tr nav_help}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" IsChecked="{Binding IsDev, Mode=OneWay}" Command="{Binding GoCommand}" CommandParameter="Dev"
                                     Visibility="{Binding DeveloperMode, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE943;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,10,0"/><TextBlock Text="{l:Tr nav_dev}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- pages -->
            <Grid Grid.Column="1">
                <v:SimpleView Visibility="{Binding IsHome, Converter={StaticResource BoolVis}}"/>
                <v:AdvancedView Visibility="{Binding IsAdvanced, Converter={StaticResource BoolVis}}"/>
                <v:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource BoolVis}}"/>
                <v:HelpView Visibility="{Binding IsHelp, Converter={StaticResource BoolVis}}"/>
                <v:DeveloperView Visibility="{Binding IsDev, Converter={StaticResource BoolVis}}"/>

                <!-- toast -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18" Padding="20,11" CornerRadius="22"
                        Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Effect="{StaticResource NeonGlow}"
                        Visibility="{Binding ToastVisible, Converter={StaticResource BoolVis}}" IsHitTestVisible="False">
                    <TextBlock Text="{Binding Toast}" FontSize="13" TextWrapping="Wrap" MaxWidth="560"/>
                </Border>
            </Grid>
        </Grid>

        <!-- status strip -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,9">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LatencyText}" Style="{StaticResource Muted}" Margin="16,0,0,0" FlowDirection="LeftToRight"
                           Visibility="{Binding DeveloperMode, Converter={StaticResource BoolVis}}"/>
                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,10,0" Fill="{Binding VirtualBrush}"/>
                <TextBlock Text="{Binding StatusBanner}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>

        <!-- first-run wizard -->
        <v:WizardView Grid.RowSpan="2" Visibility="{Binding WizardVisible, Converter={StaticResource BoolVis}}"/>
    </Grid>
</UserControl>
