<UserControl x:Class="ASTRO.Polswid.App.Views.DeveloperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ASTRO.Polswid.App.Controls"
             xmlns:l="clr-namespace:ASTRO.Polswid.App.Localization">
    <UserControl.Resources>
        <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="32,26,20,26" MaxWidth="980">
            <TextBlock Text="{l:Tr dev_title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:Tr dev_sub}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,14"/>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr dev_driver}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding DriverTechnical}" Style="{StaticResource Mono}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{l:Tr dev_driver_page}" Command="{Binding OpenDriverPageCommand}"/>
                            <Button Content="{l:Tr btn_retry}" Command="{Binding RetryCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr dev_api}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding DeviceListText}" Style="{StaticResource Mono}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr dev_perf}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding DevPerf}" Style="{StaticResource Mono}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"/>
                            <Button Content="{l:Tr dev_restart}" Command="{Binding RestartPipelineCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr dev_errors}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding DevError}" Style="{StaticResource Mono}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr dev_raw}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding DevRaw}" Style="{StaticResource Mono}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr dev_virtual_state}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding DevVirtualState}" Style="{StaticResource Mono}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Height="320">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{l:Tr dev_open_logs}" Command="{Binding OpenLogFolderCommand}"/>
                            <Button Content="{l:Tr dev_copy_log}" Command="{Binding CopyLogCommand}"/>
                            <Button Content="{l:Tr dev_clear_log}" Command="{Binding ClearLogCommand}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{l:Tr dev_log}" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="Log" ItemsSource="{Binding LogLines}" FontFamily="Cascadia Mono, Consolas" FontSize="11" FlowDirection="LeftToRight"
                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
