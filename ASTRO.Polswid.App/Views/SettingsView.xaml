<UserControl x:Class="ASTRO.Polswid.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ASTRO.Polswid.App.Controls"
             xmlns:l="clr-namespace:ASTRO.Polswid.App.Localization">
    <ScrollViewer>
        <StackPanel MaxWidth="760" Margin="32,28,32,28" HorizontalAlignment="Center">
            <TextBlock Text="{l:Tr set_title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:Tr set_sub}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,18"/>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="{l:Tr set_language}" Style="{StaticResource H2}" Margin="0"/><c:HelpButton Topic="language"/></StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Tab}" Content="{l:Tr set_lang_ar}" IsChecked="{Binding LanguageIsArabic, Mode=OneWay}" GroupName="lang" Click="Ar_Click"/>
                        <RadioButton Style="{StaticResource Tab}" Content="{l:Tr set_lang_en}" IsChecked="{Binding LanguageIsEnglish, Mode=OneWay}" GroupName="lang" Click="En_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="{l:Tr lbl_hotkeys}" IsChecked="{Binding GlobalHotkeys, Mode=TwoWay}"/>
                        <c:HelpButton Topic="hotkeys"/><c:Badge Kind="recommended"/>
                    </StackPanel>
                    <TextBlock Text="{l:Tr set_hotkeys_hint}" Style="{StaticResource Muted}" Margin="28,0,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Button Style="{StaticResource Big}" Content="{l:Tr set_open_advanced}" Command="{Binding GoCommand}" CommandParameter="Advanced" HorizontalAlignment="Left"/>
                    <Button Style="{StaticResource Big}" Content="{l:Tr set_wizard}" Command="{Binding RunWizardCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="{l:Tr set_restore}" Style="{StaticResource H2}" Margin="0"/><c:HelpButton Topic="restore"/></StackPanel>
                    <TextBlock Text="{l:Tr set_restore_desc}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                    <Button Style="{StaticResource Big}" Content="{l:Tr set_restore}" Command="{Binding RestoreDefaultsCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="{l:Tr set_dev}" IsChecked="{Binding DeveloperMode, Mode=TwoWay}"/>
                        <c:HelpButton Topic="devmode"/><c:Badge Kind="advanced"/>
                    </StackPanel>
                    <TextBlock Text="{l:Tr set_dev_desc}" Style="{StaticResource Muted}" Margin="28,0,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
