<UserControl x:Class="ASTRO.Polswid.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ASTRO.Polswid.App.Controls"
             xmlns:l="clr-namespace:ASTRO.Polswid.App.Localization">
    <Grid Margin="32,26,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{l:Tr help_title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:Tr help_sub}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,14"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Grid><TextBox x:Name="Search" Width="420" FontSize="14" Padding="12,9" TextChanged="Search_TextChanged"/><TextBlock x:Name="Placeholder" IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}" Margin="14,0" VerticalAlignment="Center" Text="{l:Tr help_search}"/></Grid>
            <Button Content="{l:Tr help_clear}" Margin="10,0,0,0" Click="Clear_Click"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2">
            <StackPanel MaxWidth="860" HorizontalAlignment="Stretch" Margin="0,0,12,20">
                <TextBlock x:Name="NoResults" Text="{l:Tr help_none}" Style="{StaticResource Muted}" Visibility="Collapsed" Margin="0,8"/>
                <TextBlock x:Name="FaqHeader" Text="{l:Tr help_faq}" Style="{StaticResource H2}" FontSize="16"/>
                <StackPanel x:Name="FaqPanel"/>
                <TextBlock x:Name="TopicHeader" Text="{l:Tr help_settings}" Style="{StaticResource H2}" FontSize="16" Margin="0,18,0,8"/>
                <StackPanel x:Name="TopicPanel"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
