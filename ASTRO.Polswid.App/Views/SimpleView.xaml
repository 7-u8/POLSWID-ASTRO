<UserControl x:Class="ASTRO.Polswid.App.Views.SimpleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ASTRO.Polswid.App.Controls"
             xmlns:l="clr-namespace:ASTRO.Polswid.App.Localization">
    <UserControl.Resources>
        <Style x:Key="Seg" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource NeonBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Dir" TargetType="Border">
            <Setter Property="Width" Value="64"/><Setter Property="Height" Value="46"/><Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="4,0"/><Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DirL" TargetType="Border" BasedOn="{StaticResource Dir}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DirLeft}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Effect" Value="{StaticResource NeonGlow}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DirR" TargetType="Border" BasedOn="{StaticResource Dir}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DirRight}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Effect" Value="{StaticResource NeonGlow}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="860" Margin="32,28,32,28" HorizontalAlignment="Center">
            <TextBlock Text="{l:Tr home_title}" Style="{StaticResource H1}" FontSize="28"/>
            <TextBlock Text="{l:Tr home_sub}" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,20"/>

            <!-- 4. master switch -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding RemappingEnabled, Mode=OneWay}" Command="{Binding ToggleRemappingCommand}"
                                  VerticalAlignment="Center" LayoutTransform="{StaticResource BigScale}" Margin="6,0,18,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:Tr home_master}" FontSize="20" FontWeight="SemiBold"/>
                            <c:HelpButton Topic="enable"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MasterText}" Style="{StaticResource Muted}" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1+2+3. controllers and connection -->
            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{l:Tr home_physical_title}" Style="{StaticResource H2}" Margin="0"/>
                            <c:HelpButton Topic="physical"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding DeviceChoices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" ItemTemplate="{StaticResource DeviceItem}" HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Ellipse Width="12" Height="12" Fill="{Binding PhysicalBrush}" Margin="0,3,10,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding PhysicalText}" FontSize="14"/>
                        </StackPanel>
                        <TextBlock Text="{l:Tr api_sdl}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Button Content="{l:Tr refresh_controllers}" Command="{Binding RefreshControllersCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding PhysicalDiscoveryError}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                        <TextBlock Text="{l:Tr hidhide_missing_hint}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                                   Visibility="{Binding NeedsControllerAccessHelp, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{l:Tr home_virtual_title}" Style="{StaticResource H2}" Margin="0"/>
                            <c:HelpButton Topic="virtual"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Seg}" Content="{l:Tr out_x360}" Tag="{Binding OutputIsX360}" Command="{Binding PickOutputCommand}" CommandParameter="Xbox360"/>
                            <Button Style="{StaticResource Seg}" Content="DualShock 4" Tag="{Binding OutputIsDs4}" Command="{Binding PickOutputCommand}" CommandParameter="DualShock4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Ellipse Width="12" Height="12" Fill="{Binding VirtualBrush}" Margin="0,3,10,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding VirtualText}" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding VirtualProblem, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
                            <TextBlock Text="{Binding StatusBanner}" Foreground="{StaticResource WarnBrush}" FontSize="12"/>
                            <Button Content="{l:Tr btn_retry}" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Expander Header="{l:Tr hidhide_setup_title}" Margin="0,0,0,14">
                <StackPanel Margin="12">
                    <TextBlock Text="{Binding HidHideStatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="{l:Tr hidhide_check}" Command="{Binding CheckHidHideCommand}"/>
                        <Button Content="{l:Tr hidhide_allow_this_app}" Command="{Binding AllowHidHideCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{l:Tr hidhide_reader_path}" Margin="0,10,0,4"/>
                    <TextBox Text="{Binding ReaderExecutablePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                    <Button Content="{l:Tr hidhide_copy_path}" Command="{Binding CopyReaderPathCommand}" HorizontalAlignment="Left" Margin="0,6,0,10"/>
                    <TextBlock Text="{Binding HidHideSetupInstructions}" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>

            <!-- 5. live buttons and direction -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Style="{StaticResource Seg}" Content="{l:Tr home_view_virt}" Tag="{Binding HomeViewVirtual}" Command="{Binding SetHomeViewVirtualCommand}"/>
                            <Button Style="{StaticResource Seg}" Content="{l:Tr home_view_phys}" Tag="{Binding HomeViewPhysical}" Command="{Binding SetHomeViewPhysicalCommand}"/>
                        </StackPanel>
                        <c:ControllerView State="{Binding HomeLiveState}" Height="230" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="{l:Tr home_live_title}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{l:Tr home_direction}" Style="{StaticResource Muted}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                            <Border Style="{StaticResource DirL}">
                                <TextBlock Text="◀" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                            </Border>
                            <Border Style="{StaticResource DirR}">
                                <TextBlock Text="▶" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SteeringText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource NeonBrush}" Effect="{StaticResource NeonGlow}"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="{l:Tr home_vr2_label}" Style="{StaticResource Muted}" FontSize="13"/>
                            <TextBlock Text=":" Style="{StaticResource Muted}" Margin="4,0"/>
                            <TextBlock Text="{Binding HomeVr2Status}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource NeonBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{l:Tr home_polswid_label}" Style="{StaticResource Muted}" FontSize="13"/>
                            <TextBlock Text=":" Style="{StaticResource Muted}" Margin="4,0"/>
                            <TextBlock Text="{Binding HomePolswidStatus}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 6. double input / game config reminder -->
            <Border Style="{StaticResource Card}" Background="#1A202C" BorderBrush="{StaticResource AccentBrush}" Padding="14" Margin="0,0,0,14">
                <TextBlock Text="{l:Tr home_game_hint}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextBrush}"/>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Big}" Content="{l:Tr home_basic_settings}" Command="{Binding GoCommand}" CommandParameter="Settings"/>
                <Button Style="{StaticResource Danger}" Padding="22,12" FontSize="15" Content="{l:Tr btn_emergency}" Command="{Binding EmergencyStopCommand}" ToolTip="{l:Tr tip_emergency}"/>
                <Button Style="{StaticResource Big}" Content="{l:Tr btn_clear_emergency}" Command="{Binding ClearEmergencyCommand}" Visibility="{Binding EmergencyStopped, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            <TextBlock Text="{l:Tr home_note}" Style="{StaticResource Muted}" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
